      "id": "b000019",
      "kind": "fenced_code",
      "start_line": 30,
      "end_line": 32,
      "raw": "```bash\nscripts/ci/run_tests_with_coverage.sh\n```\n",
      "language": "bash",
      "code": "scripts/ci/run_tests_with_coverage.sh\n",
      "closed": true
    },
    {
      "id": "b000020",
      "kind": "blank",
