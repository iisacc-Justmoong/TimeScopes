      "id": "b000001",
      "kind": "heading",
      "start_line": 1,
      "end_line": 1,
      "raw": "# Time Scopes\n",
      "level": 1,
      "title": "Time Scopes"
    },
    {
      "id": "b000002",
      "kind": "blank",
      "start_line": 2,
      "end_line": 2,
      "raw": "\n"
    },
    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 3,
      "raw": "Time Scopes is a SwiftUI iOS app for visualizing life-time metrics, calendar and reminder events, and Screen Time usage in the Pulse tab.\n"
    },
    {
      "id": "b000004",
      "kind": "blank",
      "start_line": 4,
      "end_line": 4,
      "raw": "\n"
    },
    {
      "id": "b000005",
      "kind": "paragraph",
      "start_line": 5,
      "end_line": 5,
      "raw": "**Features**\n"
    },
    {
      "id": "b000006",
      "kind": "list",
      "start_line": 6,
      "end_line": 10,
      "raw": "- Home dashboard with life-time and remaining-time metrics.\n- Calendar and Reminders timeline views (read-only).\n- Pulse Screen Time reports (weekly, daily, and today).\n- Pulse Daily Journal now accepts direct entry capture without rotating prompt questions.\n- Preferences tab for managing permissions.\n",
      "items": [
        {
          "marker": "-",
          "text": "Home dashboard with life-time and remaining-time metrics.",
          "checked": null
        },
        {
          "marker": "-",
          "text": "Calendar and Reminders timeline views (read-only).",
          "checked": null
        },
        {
          "marker": "-",
          "text": "Pulse Screen Time reports (weekly, daily, and today).",
          "checked": null
        },
        {
          "marker": "-",
          "text": "Pulse Daily Journal now accepts direct entry capture without rotating prompt questions.",
          "checked": null
        },
        {
          "marker": "-",
          "text": "Preferences tab for managing permissions.",
          "checked": null
        }
      ]
    },
    {
      "id": "b000007",
      "kind": "blank",
      "start_line": 11,
      "end_line": 11,
      "raw": "\n"
    },
    {
